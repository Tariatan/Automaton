<Window x:Class="Automaton.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Discovery Automation"
        Topmost="True"
        ResizeMode="NoResize"
        Height="301"
        Width="532"
        WindowStyle="None"
        Background="#061018">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07111A" Offset="0" />
            <GradientStop Color="#102432" Offset="0.56" />
            <GradientStop Color="#071019" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#09131D" Offset="0" />
            <GradientStop Color="#112C3C" Offset="0.64" />
            <GradientStop Color="#08111A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#132837" Offset="0" />
            <GradientStop Color="#0A1722" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextBrush" Color="#D9E8F0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A7B4" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#31536A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#41C9F3" />
        <SolidColorBrush x:Key="MainPanelBackgroundBrush" Color="#0D1A25" />
        <LinearGradientBrush x:Key="SelectedNavTabBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E6B8B" Offset="0" />
            <GradientStop Color="#16465F" Offset="0.38" />
            <GradientStop Color="#0D1A25" Offset="0.78" />
            <GradientStop Color="#0D1A25" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ChromeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#A9BBC8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#203547" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C526C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Foreground" Value="#91A7B4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="#08151F"
                                    BorderBrush="#163044"
                                    BorderThickness="0,0,1,1" />
                            <Border x:Name="Accent"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <Grid x:Name="SelectionIndicator"
                                  Width="28"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False"
                                  Opacity="0">
                                <Border Width="24"
                                        HorizontalAlignment="Right">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#002CAED0" Offset="0" />
                                            <GradientStop Color="#102CAED0" Offset="0.45" />
                                            <GradientStop Color="#000D1A25" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Path Width="16"
                                      Height="34"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M2,4 L15,17 L2,30"
                                      Opacity="0.72"
                                      Stretch="Fill"
                                      Stroke="#3AA5C9"
                                      StrokeEndLineCap="Square"
                                      StrokeLineJoin="Miter"
                                      StrokeStartLineCap="Square"
                                      StrokeThickness="3" />
                            </Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedNavTabBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MainPanelBackgroundBrush}" />
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="0.74" />
                                <Setter Property="Foreground" Value="#F0FBFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#123044" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MainTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#08131D"
                                    BorderBrush="#183246"
                                    BorderThickness="0,0,1,0" />
                            <TabPanel Grid.Column="0"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Column="1"
                                    Padding="18"
                                    Background="{StaticResource MainPanelBackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelChromeStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Semilight" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InputStyle" TargetType="{x:Type Control}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#D9E8F0" />
            <Setter Property="Background" Value="#0A1823" />
            <Setter Property="BorderBrush" Value="#34566F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#9DF8FF" />
            <Setter Property="SelectionBrush" Value="#2E8AA8" />
        </Style>
        <Style x:Key="ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#CFE1EA" />
            <Setter Property="Background" Value="#081722" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D5B76" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#43C8F2" />
                                <Setter Property="Foreground" Value="#F4FCFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#143F55" />
                                <Setter Property="Foreground" Value="#9DF8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboInputStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Left"
                                                           Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        BorderBrush="#254B62"
                                                        BorderThickness="1,0,0,0"
                                                        Background="#0D2230">
                                                    <Path Width="12"
                                                          Height="7"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#9ED8EA"
                                                          Stretch="Uniform"
                                                          Data="M0,0 L12,0 L6,7 Z" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#51B6DA" />
                                                <Setter TargetName="Root" Property="Background" Value="#102838" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="BorderBrush" Value="#67D7F5" />
                                                <Setter TargetName="Root" Property="Background" Value="#123044" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#07131D"
                                            BorderBrush="#51B6DA"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18"
                                                              Color="#1FA7CF"
                                                              Opacity="0.45"
                                                              ShadowDepth="0" />
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="1"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  CanContentScroll="True"
                                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#C8D7E0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Foreground" Value="#D9E8F0" />
            <Setter Property="Background" Value="#122D40" />
            <Setter Property="BorderBrush" Value="#3D718E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#17435B" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#51B6DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0E2433" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAutomationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="420" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Foreground" Value="#F7FFF9" />
            <Setter Property="Background" Value="#2D8853" />
            <Setter Property="BorderBrush" Value="#9BFFC0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <Border CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4AFFFFFF" Offset="0" />
                                            <GradientStop Color="#10FFFFFF" Offset="0.48" />
                                            <GradientStop Color="#26000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Border Width="760"
            Height="430"
            BorderBrush="#31536A"
            BorderThickness="1"
            Background="{StaticResource WindowBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="75*" />
                    <RowDefinition Height="301*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                            <Viewbox Width="24"
                                 Height="30"
                                 Margin="0,0,12,0">
                                <Canvas Width="24" Height="30">
                                    <Path Stroke="#2BC3DE"
                                      StrokeThickness="2"
                                      Data="M7,2 C18,8 18,22 7,28" />
                                    <Path Stroke="#2BC3DE"
                                      StrokeThickness="2"
                                      Data="M17,2 C6,8 6,22 17,28" />
                                    <Line X1="8" Y1="8" X2="16" Y2="8" Stroke="#2BC3DE" StrokeThickness="2" />
                                    <Line X1="6" Y1="15" X2="18" Y2="15" Stroke="#2BC3DE" StrokeThickness="2" />
                                    <Line X1="8" Y1="22" X2="16" Y2="22" Stroke="#2BC3DE" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="PROJECT DISCOVERY AUTOMATION"
                                   Foreground="#AFC5D2"
                                   FontFamily="Segoe UI Light"
                                   FontSize="25"
                                   VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                            <Button x:Name="PinButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Toggle always on top"
                                Click="PinButton_Click">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="20" Height="20">
                                        <Path Stroke="#A9BBC8"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M6,3 L15,12 M12,4 L16,8 L13,11 L16,15 L14,17 L10,13 L5,18 L7,13 L4,10 L8,6" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click">
                                <Viewbox Width="15" Height="15">
                                    <Path Stroke="#A9BBC8"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M2,11 L14,11" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ChromeButtonStyle}"
                                Background="#652431"
                                ToolTip="Close"
                                Click="CloseButton_Click">
                                <Viewbox Width="15" Height="15">
                                    <Path Stroke="#F2DDE2"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M3,3 L13,13 M13,3 L3,13" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <TabControl Grid.Row="1"
                        TabStripPlacement="Left"
                        Style="{StaticResource MainTabControlStyle}" Grid.RowSpan="2">
                    <TabItem x:Name="HomeTabItem"
                         Style="{StaticResource NavTabItemStyle}" Margin="0,19,0,-19">
                        <TabItem.Header>
                            <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Viewbox Width="31"
                                     Height="31"
                                     Margin="0,0,0,6">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                      Data="M16,3 L30,15 H26 V30 H19 V21 H13 V30 H6 V15 H2 Z" />
                                </Viewbox>
                                <TextBlock Style="{StaticResource NavHeaderTextStyle}"
                                       Text="HOME" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="54" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                Style="{StaticResource PanelChromeStyle}"
                                Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="98" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Viewbox Grid.Row="0"
                                         Width="430"
                                         Height="88"
                                         HorizontalAlignment="Center" Margin="0,1,0,9">
                                        <Canvas Width="560" Height="96">
                                            <Canvas Width="462" Height="96">
                                                <Canvas.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#55FFFFFF" Offset="0.08" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="0.18" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="0.68" />
                                                        <GradientStop Color="#55FFFFFF" Offset="0.84" />
                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Canvas.OpacityMask>
                                                <Ellipse Width="96"
                                                         Height="90"
                                                         Canvas.Left="225"
                                                         Canvas.Top="3"
                                                         Stroke="#2D647A"
                                                         StrokeThickness="6"
                                                         Opacity="0.45" />
                                                <Path Stroke="#254D64"
                                                      StrokeThickness="5.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M-52,48 C-8,12 38,12 82,48 S168,84 212,48 298,12 342,48 428,84 472,48" />
                                                <Path Stroke="#254D64"
                                                      StrokeThickness="5.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M-52,48 C-8,84 38,84 82,48 S168,12 212,48 298,84 342,48 428,12 472,48" />
                                                <Line X1="26" Y1="37" X2="26" Y2="59" Stroke="#315D75" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.58" />
                                                <Line X1="58" Y1="33" X2="58" Y2="63" Stroke="#416D86" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Line X1="90" Y1="36" X2="90" Y2="60" Stroke="#416D86" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Line X1="128" Y1="42" X2="128" Y2="54" Stroke="#315D75" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7" />
